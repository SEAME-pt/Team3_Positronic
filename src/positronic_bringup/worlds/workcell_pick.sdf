<?xml version="1.0"?>
<sdf version="1.9">
  <!-- workcell.sdf plus what the pick verification needs (docs/03_verification/gazebo_pick):
       a pedestal in front of the arm, a 2.5 cm cube on it, and a fixed camera that watches the
       pick from the front of the bench. Same world name, so the Gazebo services do not change. -->
  <world name="positronic_workcell">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bench">
      <static>true</static>
      <pose>0 0 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.70 0.70 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.70 0.70 0.75</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="work_box">
      <static>true</static>
      <link name="wall_front">
        <pose>0.33 0.00 1.05 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.02 0.68 0.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 0.68 0.60</size></box></geometry>
          <material><ambient>0.60 0.80 1.00 0.25</ambient><diffuse>0.70 0.85 1.00 0.25</diffuse><specular>0.9 0.9 0.9 1</specular></material>
          <transparency>0.75</transparency>
        </visual>
      </link>
      <link name="wall_back">
        <pose>-0.33 0.00 1.05 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.02 0.68 0.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 0.68 0.60</size></box></geometry>
          <material><ambient>0.60 0.80 1.00 0.25</ambient><diffuse>0.70 0.85 1.00 0.25</diffuse><specular>0.9 0.9 0.9 1</specular></material>
          <transparency>0.75</transparency>
        </visual>
      </link>
      <link name="wall_left">
        <pose>0.00 0.33 1.05 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.64 0.02 0.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.64 0.02 0.60</size></box></geometry>
          <material><ambient>0.60 0.80 1.00 0.25</ambient><diffuse>0.70 0.85 1.00 0.25</diffuse><specular>0.9 0.9 0.9 1</specular></material>
          <transparency>0.75</transparency>
        </visual>
      </link>
      <link name="wall_right">
        <pose>0.00 -0.33 1.05 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.64 0.02 0.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.64 0.02 0.60</size></box></geometry>
          <material><ambient>0.60 0.80 1.00 0.25</ambient><diffuse>0.70 0.85 1.00 0.25</diffuse><specular>0.9 0.9 0.9 1</specular></material>
          <transparency>0.75</transparency>
        </visual>
      </link>
      <link name="roof">
        <pose>0.00 0.00 1.36 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.68 0.68 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.68 0.68 0.02</size></box></geometry>
          <material><ambient>0.60 0.80 1.00 0.25</ambient><diffuse>0.70 0.85 1.00 0.25</diffuse><specular>0.9 0.9 0.9 1</specular></material>
          <transparency>0.75</transparency>
        </visual>
      </link>
    </model>

    <!-- 6 x 6 x 8 cm pedestal, top at 0.83 m. -->
    <model name="pedestal">
      <static>true</static>
      <pose>0.17 0 0.79 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.06 0.06 0.08</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.08</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 2.5 cm cube, 20 g, on the pedestal. Friction 1.5 stands in for the rubber pads. -->
    <model name="cube">
      <pose>0.17 0 0.8425 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia><ixx>2.1e-6</ixx><iyy>2.1e-6</iyy><izz>2.1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <material><ambient>1 0.2 0.1 1</ambient><diffuse>1 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Fixed camera in front of the bench, looking at the pedestal. Small and slow on purpose:
         every camera costs simulation speed without a GPU. Bridged by the verification script. -->
    <model name="scene_camera">
      <static>true</static>
      <pose>0.55 -0.35 0.95 0 0.21 2.398</pose>
      <link name="link">
        <sensor name="scene_camera" type="camera">
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <topic>scene_camera/image_raw</topic>
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>5.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
