<?xml version="1.0"?>
<!--
  Arm model for the real myCobot 280 on the Jetson (#23).
    Includes the gripper and camera model (#97) URDF of this package
    and adds a <ros2_control> for the arm joints and the gripper.

  Differs from positronic_gazebo.urdf.xacro on purpose:
  - the plugin is positronic_hardware/RobotSystem, not the Gazebo one;
  - each arm joint has position AND velocity state interfaces, which the plugin requires;
  - each arm joint has exactly one command interface, position, which the plugin requires (#32);
  - ros2_control's joint limiter is off on every joint (#34), see the macro below.

  The <param> names are the ones the plugin reads in on_init (#22): backend, fake_mode, port,
  baud, moving_period_ms, echo_timeout_ms, pose_from_poll, servo_temp_limit_c,
  tracking_error_deg, tracking_error_ms, supervisor_timeout_ms, load_relief, send_speed.
  It rejects any other name, so a typo here stops the driver instead of being ignored.

  The defaults are the driver's, in one place: HardwareConfig and SerialTiming in
  positronic_hardware, with the reason for each value (table in its README). An argument left
  unset writes no <param>, so the driver keeps its own default; the INFO line of on_init prints
  the values in use. A default here as well would win over the driver's and hide a change there.

  The joints are listed in protocol order, J1 (base) first, J6 (flange) last: the plugin maps
  the six angles of get_angles to the joints in this order.
-->
<robot name="positronic" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- "serial" talks to the arm; "fake" stands still, to try the launch without the arm. -->
  <xacro:arg name="backend" default=""/>
  <!-- How the fake backend moves (#122): "instant", at every target at once, or "measured",
       with the lag, the late wrist and the rest error of the real arm. -->
  <xacro:arg name="fake_mode" default=""/>
  <!-- The arm's UART and its rate (115200 or 1000000 baud). -->
  <xacro:arg name="port" default=""/>
  <xacro:arg name="baud" default=""/>
  <!-- Timings of the serial thread, in ms (#32, #150): the length of a turn that sends, and
       the longest wait for the Atom's sync-write after a send. -->
  <xacro:arg name="moving_period_ms" default=""/>
  <xacro:arg name="echo_timeout_ms" default=""/>
  <!-- "true": the pose comes from the Atom's own poll of the servos and the turn follows the
       controller's write (#170); "false": a get_angles every turn, as #150. -->
  <xacro:arg name="pose_from_poll" default=""/>
  <!-- A servo at or above this temperature (degC) stops the arm and powers its servos off.
       Lower only, to test the cut without heating anything. -->
  <xacro:arg name="servo_temp_limit_c" default=""/>
  <!-- A joint further than tracking_error_deg from its target for longer than tracking_error_ms
       is a fault (#103): the arm did not follow the command. Wider than the controller's 5 deg
       trajectory tolerance on purpose, so the controller aborts first. -->
  <xacro:arg name="tracking_error_deg" default=""/>
  <xacro:arg name="tracking_error_ms" default=""/>
  <!-- The dead-man check (#136): no heartbeat from the safety supervisor for this many ms while
       active halts the arm. 0 turns it off, for a run without the supervisor. -->
  <xacro:arg name="supervisor_timeout_ms" default=""/>
  <!-- A still joint pushing short of its target is sent where it stands, so it stops pushing
       and heating (#183); "false" turns it off. -->
  <xacro:arg name="load_relief" default=""/>
  <!-- Speed byte of every send_angles, 1 to 100: a speed cap. Default 30, see ADR 0008. -->
  <xacro:arg name="send_speed" default=""/>

  <!-- One driver <param>, written only when its argument is set. -->
  <xacro:macro name="driver_param" params="name">
    <xacro:if value="${xacro.arg(name) != ''}">
      <param name="${name}">${xacro.arg(name)}</param>
    </xacro:if>
  </xacro:macro>

  <!-- Links, joints and meshes of the arm, with the gripper and the wrist camera: camera_flange
       and the camera_link frame under joint 6, mounted as on the real arm (#97). camera_link is
       the frame_id of the real camera images (camera.launch.py) and the link the Gazebo camera
       sits on. The <gazebo> tags of that file are ignored outside Gazebo. -->
  <xacro:include filename="$(find positronic_description)/urdf/mycobot_280_jn_sim/mycobot_280_jn_gripper_camera.urdf"/>

  <!-- One joint as seen by ros2_control: we read position and velocity, we command position. !-->
  <xacro:macro name="real_arm_joint" params="name">
    <joint name="${name}">
      <limits enable="false"/>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="positronic_arm" type="system">
    <hardware>
      <plugin>positronic_hardware/RobotSystem</plugin>
      <xacro:driver_param name="backend"/>
      <xacro:driver_param name="fake_mode"/>
      <xacro:driver_param name="port"/>
      <xacro:driver_param name="baud"/>
      <xacro:driver_param name="moving_period_ms"/>
      <xacro:driver_param name="echo_timeout_ms"/>
      <xacro:driver_param name="pose_from_poll"/>
      <xacro:driver_param name="servo_temp_limit_c"/>
      <xacro:driver_param name="tracking_error_deg"/>
      <xacro:driver_param name="tracking_error_ms"/>
      <xacro:driver_param name="supervisor_timeout_ms"/>
      <xacro:driver_param name="load_relief"/>
      <xacro:driver_param name="send_speed"/>
    </hardware>
    <xacro:real_arm_joint name="joint2_to_joint1"/>
    <xacro:real_arm_joint name="joint3_to_joint2"/>
    <xacro:real_arm_joint name="joint4_to_joint3"/>
    <xacro:real_arm_joint name="joint5_to_joint4"/>
    <xacro:real_arm_joint name="joint6_to_joint5"/>
    <xacro:real_arm_joint name="joint6output_to_joint6"/>
    <xacro:real_arm_joint name="gripper_controller"/>
    <!-- #35: what the driver reports to the supervisor (#45), as driver/fault_code. 0 = no
         fault; any other value is a latched fault, see FaultCode in positronic_hardware.hpp. -->
    <gpio name="driver">
      <state_interface name="fault_code"/>
      <state_interface name="pose_age_s"/>
    </gpio>
  </ros2_control>
</robot>
