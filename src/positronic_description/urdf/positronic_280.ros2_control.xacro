<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="positronic_arm_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="positronic_ros2_control" params="hardware serial_port baud_rate watchdog_timeout_ms">
    <ros2_control name="MyCobotSystem" type="system">
      <hardware>
        <xacro:if value="${hardware == 'real'}">
          <plugin>positronic_hardware/MyCobotHardwareInterface</plugin>
          <param name="serial_port">${serial_port}</param>
          <param name="baud_rate">${baud_rate}</param>
          <param name="watchdog_timeout_ms">${watchdog_timeout_ms}</param>
        </xacro:if>
        <xacro:if value="${hardware == 'gazebo'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
      </hardware>

      <xacro:positronic_arm_joint name="joint2_to_joint1"/>
      <xacro:positronic_arm_joint name="joint3_to_joint2"/>
      <xacro:positronic_arm_joint name="joint4_to_joint3"/>
      <xacro:positronic_arm_joint name="joint5_to_joint4"/>
      <xacro:positronic_arm_joint name="joint6_to_joint5"/>
      <xacro:positronic_arm_joint name="joint6output_to_joint6"/>

      <joint name="gripper_controller">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <xacro:if value="${hardware == 'gazebo'}">
        <xacro:macro name="positronic_gripper_mimic" params="name">
          <joint name="${name}" mimic="true">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
          </joint>
        </xacro:macro>
        <xacro:positronic_gripper_mimic name="gripper_base_to_gripper_left2"/>
        <xacro:positronic_gripper_mimic name="gripper_left3_to_gripper_left1"/>
        <xacro:positronic_gripper_mimic name="gripper_base_to_gripper_right3"/>
        <xacro:positronic_gripper_mimic name="gripper_base_to_gripper_right2"/>
        <xacro:positronic_gripper_mimic name="gripper_right3_to_gripper_right1"/>
      </xacro:if>
    </ros2_control>
  </xacro:macro>

</robot>
