<?xml version="1.0"?>
<!--
  Arm model for Gazebo. Includes the plain URDF of this package and adds
  what ros2_control needs: the joints it can command and the Gazebo plugin
  that runs the controller_manager inside the simulation.
-->
<robot name="positronic" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Path of the controllers yaml, given by the launch file. -->
  <xacro:arg name="controllers_file" default=""/>

  <!-- Links, joints and meshes of the arm. -->
  <xacro:include filename="$(find positronic_description)/urdf/mycobot_280_jn_sim/mycobot_280_jn_gripper_camera.urdf"/>

  <!-- One joint as seen by ros2_control: we command position, we read position. -->
  <xacro:macro name="arm_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
  </xacro:macro>

  <!-- One finger joint as seen by ros2_control: state only. The URDF gives it a mimic tag on
       gripper_controller, and ros2_control only registers that tag for joints listed here.
       Registered, gz_ros2_control drives the finger; left out, the Gazebo physics engine
       ignores the mimic tag and the finger hangs loose. -->
  <xacro:macro name="finger_joint" params="name">
    <joint name="${name}">
      <state_interface name="position"/>
    </joint>
  </xacro:macro>

  <!-- The hardware plugin is the Gazebo one. On the real arm only this block changes. -->
  <ros2_control name="positronic_arm" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:arm_joint name="joint2_to_joint1"/>
    <xacro:arm_joint name="joint3_to_joint2"/>
    <xacro:arm_joint name="joint4_to_joint3"/>
    <xacro:arm_joint name="joint5_to_joint4"/>
    <xacro:arm_joint name="joint6_to_joint5"/>
    <xacro:arm_joint name="joint6output_to_joint6"/>
    <joint name="gripper_controller">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <xacro:finger_joint name="gripper_base_to_gripper_left2"/>
    <xacro:finger_joint name="gripper_left3_to_gripper_left1"/>
    <xacro:finger_joint name="gripper_base_to_gripper_right3"/>
    <xacro:finger_joint name="gripper_base_to_gripper_right2"/>
    <xacro:finger_joint name="gripper_right3_to_gripper_right1"/>
  </ros2_control>

  <!-- Gazebo loads this plugin with the model. It starts the controller_manager with this yaml. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>

</robot>
