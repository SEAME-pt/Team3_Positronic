<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>positronic_hardware</name>
  <version>0.0.0</version>
  <description>ros2_control hardware interface for the myCobot 280 Jetson Nano arm.</description>
  <maintainer email="example@seame.pt">dev</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>positronic_protocol</depend>
  <depend>realtime_tools</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_cpp</test_depend>
  <test_depend>lifecycle_msgs</test_depend>
  <test_depend>positronic_description</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>