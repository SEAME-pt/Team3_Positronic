<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>positronic_safety</name>
  <version>0.0.0</version>
  <description>Safety supervisor of the arm (#45): halts it on a stop request, a lost mission heartbeat or a driver fault, and keeps it stopped until a person resumes.</description>
  <maintainer email="example@seame.pt">Felipe Suassuna</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
