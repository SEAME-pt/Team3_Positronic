<?xml version="1.0"?>
<robot name="mycobot_280_jn">
  <link name="world"/>
  <joint name="world_to_g_base" type="fixed"><parent link="world"/><child link="g_base"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  <link name="g_base">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/visual/g_base.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/collision/g_base.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.000004 0.000000 0.016000" rpy="0 0 0"/>
      <mass value="1.00000"/>
      <inertia ixx="1.9413e-03" ixy="3.1506e-09" ixz="8.1608e-14" iyy="1.0835e-03" iyz="-2.2217e-08" izz="2.8542e-03"/>
    </inertial>
  </link>
  <joint name="g_base_to_joint1" type="fixed"><parent link="g_base"/><child link="joint1"/><origin xyz="0 0 0.0320" rpy="0 0 0"/></joint>

  <link name="joint1">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/visual/joint1.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/collision/joint1.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.000007 -0.000080 0.049738" rpy="0 0 0"/>
      <mass value="0.51726"/>
      <inertia ixx="1.2523e-03" ixy="7.0339e-09" ixz="-6.3450e-08" iyy="9.3955e-04" iyz="1.1529e-06" izz="1.2061e-03"/>
    </inertial>
  </link>
  <link name="joint2">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/visual/joint2.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/collision/joint2.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.000000 -0.006642 -0.021543" rpy="0 0 0"/>
      <mass value="0.06483"/>
      <inertia ixx="4.7296e-05" ixy="-1.4455e-10" ixz="4.0893e-11" iyy="4.2690e-05" iyz="5.2950e-06" izz="2.4363e-05"/>
    </inertial>
  </link>
  <link name="joint3">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/visual/joint3.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/collision/joint3.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.054329 -0.000001 0.055329" rpy="0 0 0"/>
      <mass value="0.11472"/>
      <inertia ixx="4.1667e-05" ixy="-4.5301e-09" ixz="-7.2144e-07" iyy="2.1506e-04" iyz="-8.8599e-10" izz="2.0847e-04"/>
    </inertial>
  </link>
  <link name="joint4">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/visual/joint4.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/collision/joint4.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.045854 0.000000 0.007555" rpy="0 0 0"/>
      <mass value="0.09148"/>
      <inertia ixx="3.0829e-05" ixy="2.4590e-09" ixz="-3.0073e-06" iyy="1.3707e-04" iyz="1.3305e-09" izz="1.2859e-04"/>
    </inertial>
  </link>
  <link name="joint5">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/visual/joint5.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/collision/joint5.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.000001 -0.009519 -0.008481" rpy="0 0 0"/>
      <mass value="0.02935"/>
      <inertia ixx="1.1293e-05" ixy="2.2528e-10" ixz="1.0500e-10" iyy="8.1426e-06" iyz="1.6096e-06" izz="8.8742e-06"/>
    </inertial>
  </link>
  <link name="joint6">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/visual/joint6.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/collision/joint6.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.000000 0.005619 -0.009142" rpy="0 0 0"/>
      <mass value="0.03671"/>
      <inertia ixx="1.6852e-05" ixy="1.3225e-11" ixz="9.2639e-11" iyy="1.2050e-05" iyz="-8.3674e-07" izz="1.2581e-05"/>
    </inertial>
  </link>
  <link name="joint6_flange">
    <visual>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/visual/joint6_flange.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://mycobot_description/urdf/mycobot_280_jn_sim/meshes/collision/joint6_flange.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.000000 -0.000000 -0.005150" rpy="0 0 0"/>
      <mass value="0.00565"/>
      <inertia ixx="6.0852e-07" ixy="-5.1861e-24" ixz="1.4684e-24" iyy="6.0852e-07" iyz="-7.5632e-16" izz="1.0405e-06"/>
    </inertial>
  </link>
  <joint name="joint2_to_joint1" type="revolute">
    <parent link="joint1"/><child link="joint2"/>
    <origin xyz="0 0 0.15756" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-2.9321" upper="2.9321" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>
  <joint name="joint3_to_joint2" type="revolute">
    <parent link="joint2"/><child link="joint3"/>
    <origin xyz="0 0 -0.001" rpy="0 1.5708 -1.5708"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-2.4434" upper="2.4434" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>
  <joint name="joint4_to_joint3" type="revolute">
    <parent link="joint3"/><child link="joint4"/>
    <origin xyz="-0.1104 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-2.6179" upper="2.6179" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>
  <joint name="joint5_to_joint4" type="revolute">
    <parent link="joint4"/><child link="joint5"/>
    <origin xyz="-0.096 0 0.06462" rpy="0 0 -1.5708"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-2.6179" upper="2.6179" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>
  <joint name="joint6_to_joint5" type="revolute">
    <parent link="joint5"/><child link="joint6"/>
    <origin xyz="0 -0.07318 0" rpy="1.5708 -1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-2.7052" upper="2.7925" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>
  <joint name="joint6output_to_joint6" type="revolute">
    <parent link="joint6"/><child link="joint6_flange"/>
    <origin xyz="0 0.0456 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-3.14159" upper="3.14159" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

  <!-- Gazebo: gravity off on the moving links (passive joints would otherwise fall; no controller yet) -->
  <gazebo reference="joint2"><turnGravityOff>true</turnGravityOff></gazebo>
  <gazebo reference="joint3"><turnGravityOff>true</turnGravityOff></gazebo>
  <gazebo reference="joint4"><turnGravityOff>true</turnGravityOff></gazebo>
  <gazebo reference="joint5"><turnGravityOff>true</turnGravityOff></gazebo>
  <gazebo reference="joint6"><turnGravityOff>true</turnGravityOff></gazebo>
  <gazebo reference="joint6_flange"><turnGravityOff>true</turnGravityOff></gazebo>
</robot>
