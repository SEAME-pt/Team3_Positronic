  <!-- Simulated camera, placed on the lens of Elephant's camera-module mesh and looking out of it. -->
  <link name="camera_link"/>
  <joint name="camera_flange_to_camera_link" type="fixed">
    <parent link="camera_flange"/><child link="camera_link"/>
    <origin xyz="0.0415 0.0083 0.0000" rpy="0 0 1.5708"/>
  </joint>
  <gazebo reference="camera_link">
    <sensor name="wrist_camera" type="camera">
      <always_on>1</always_on><update_rate>30</update_rate><visualize>true</visualize>
      <topic>wrist_camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>5.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Gazebo: gravity off on the moving links (passive joints would otherwise fall; no controller yet) -->
  <gazebo reference="joint2"><turnGravityOff>true</turnGravityOff></gazebo>
  <gazebo reference="joint3"><turnGravityOff>true</turnGravityOff></gazebo>
  <gazebo reference="joint4"><turnGravityOff>true</turnGravityOff></gazebo>
