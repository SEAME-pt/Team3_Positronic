  <gazebo reference="gripper_base"><turnGravityOff>true</turnGravityOff></gazebo>
  <gazebo reference="gripper_left1"><turnGravityOff>true</turnGravityOff></gazebo>
  <gazebo reference="gripper_left2"><turnGravityOff>true</turnGravityOff></gazebo>
  <gazebo reference="gripper_left3"><turnGravityOff>true</turnGravityOff></gazebo>
  <gazebo reference="gripper_right1"><turnGravityOff>true</turnGravityOff></gazebo>
