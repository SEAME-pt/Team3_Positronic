    <origin xyz="-0.005 0.027 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-0.8" upper="0.5" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.01"/>
    <mimic joint="gripper_controller" multiplier="1.0" offset="0"/>
  </joint>
