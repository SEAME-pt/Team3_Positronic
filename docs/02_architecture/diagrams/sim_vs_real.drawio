<mxfile host="drawio"><diagram id="d" name="Sim vs real"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1140" pageHeight="540"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sim" value="Simulation only (gazebo.launch.py, laptop)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;arcSize=3;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="330" height="450" as="geometry"/></mxCell><mxCell id="sh" value="Shared: the same code and config" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;arcSize=3;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="360" height="450" as="geometry"/></mxCell><mxCell id="real" value="Real arm only (supervised.launch.py, Jetson)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;arcSize=3;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="770" y="20" width="350" height="450" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;positronic_gazebo.urdf.xacro&lt;/b&gt;&lt;br&gt;hardware plugin: gz_ros2_control/GazeboSimSystem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="290" height="50" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;Gazebo physics&lt;/b&gt;: reaches every target exactly, repeats to 0.01°" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="290" height="45" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;Camera&lt;/b&gt;: Gazebo sensor + ros_gz parameter_bridge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="179" width="290" height="45" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;Controllers file&lt;/b&gt;: ros2_controllers.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="290" height="40" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b&gt;Sim time&lt;/b&gt; (use_sim_time), no serial link, no temperatures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="290" height="45" as="geometry"/></mxCell><mxCell id="g6" value="&lt;b&gt;No safety supervisor&lt;/b&gt;, no heartbeats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="345" width="290" height="40" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;positronic_description&lt;/b&gt;: links, joints, limits (the URDF both xacros build on)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="320" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;positronic_moveit_config&lt;/b&gt; + move_group: same planning, same controllers list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="122" width="320" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;mission_node&lt;/b&gt; and the GoToPose action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="184" width="320" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Controller types&lt;/b&gt;: arm_controller (JTC), gripper_action_controller, joint_state_broadcaster, &lt;b&gt;30 Hz&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="236" width="320" height="55" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Topics&lt;/b&gt;: /joint_states, /tf, /wrist_camera/image_raw: a node can't tell sim from real" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="303" width="320" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;robot_state_publisher&lt;/b&gt;, RViz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="365" width="320" height="40" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;positronic_real.urdf.xacro&lt;/b&gt;&lt;br&gt;hardware plugin: positronic_hardware/RobotSystem (serial, or fake backend in CI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="60" width="310" height="60" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;The arm&lt;/b&gt;: stops 1-1.5° short of each target; J4 (joint5_to_joint4) sits 1.5° low (#37)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="132" width="310" height="55" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Camera&lt;/b&gt;: wrist_camera.py on the same topics as Gazebo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="199" width="310" height="40" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Controllers file&lt;/b&gt;: jetson_controllers.yaml (+ forward_position_controller, allow_stalling)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="251" width="310" height="50" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;Wall clock&lt;/b&gt;, serial link watchdog, servo temperatures, fault code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="313" width="310" height="45" as="geometry"/></mxCell><mxCell id="r6" value="&lt;b&gt;safety_supervisor&lt;/b&gt; + heartbeats (#45, #136), starts inactive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="370" width="310" height="40" as="geometry"/></mxCell><mxCell id="g1x" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=1;dashed=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g1" target="c1"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r1x" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=1;dashed=1;strokeColor=#999999;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="c1"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g4x" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=1;dashed=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g4" target="c4"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r4x" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=1;dashed=1;strokeColor=#999999;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r4" target="c4"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g3x" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=1;dashed=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g3" target="c5"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r3x" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=1;dashed=1;strokeColor=#999999;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3" target="c5"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v" value="&lt;b&gt;Measured gap (#37, sim-to-real report):&lt;/b&gt; the same trajectory on the arm stays within &lt;b&gt;3.6°&lt;/b&gt; of Gazebo on every joint, RMS ≤ 1.7°. Mostly static (stops short, J4 offset), not lag. Gazebo models none of it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="485" width="1100" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>