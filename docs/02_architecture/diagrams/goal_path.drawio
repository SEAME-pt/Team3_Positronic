<mxfile host="drawio"><diagram id="d" name="Goal path"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1360" pageHeight="410"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lap" value="Laptop" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;arcSize=3;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="420" height="330" as="geometry"/></mxCell><mxCell id="jet" value="Jetson + arm" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;arcSize=3;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="460" y="20" width="880" height="330" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1. mission_node&lt;/b&gt;&lt;br&gt;GoToPose goal → MoveGroup goal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="150" height="75" as="geometry"/></mxCell><mxCell id="s1t" value="not measured" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="165" width="150" height="105" as="geometry"/></mxCell><mxCell id="s1l" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=1;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s1t"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2" value="&lt;b&gt;2. move_group&lt;/b&gt;&lt;br&gt;plans, then sends the &lt;b&gt;whole trajectory once&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="160" height="75" as="geometry"/></mxCell><mxCell id="s2t" value="planning: not measured&lt;br&gt;network: wired ≤ 1 ms; Wi-Fi pings up to 333 ms (MoveIt on the arm), so we run wired" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="165" width="160" height="105" as="geometry"/></mxCell><mxCell id="s2l" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=1;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s2t"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s3" value="&lt;b&gt;3. arm_controller&lt;/b&gt;&lt;br&gt;samples the trajectory every cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="70" width="150" height="75" as="geometry"/></mxCell><mxCell id="s3t" value="&lt;b&gt;cycle 33.3 ms&lt;/b&gt;, p99 34.0, max 37.7 ms over 18,904 cycles; same under full CPU load (#39)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="165" width="150" height="105" as="geometry"/></mxCell><mxCell id="s3l" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=1;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s3t"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s4" value="&lt;b&gt;4. write()&lt;/b&gt;&lt;br&gt;limit check, copy to buffer, wake the serial thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="70" width="150" height="75" as="geometry"/></mxCell><mxCell id="s4t" value="no I/O in write(). Before the wake (#170) the send waited for the next serial turn, up to 50 ms (#32)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="710" y="165" width="150" height="105" as="geometry"/></mxCell><mxCell id="s4l" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=1;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s4t"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s5" value="&lt;b&gt;5. serial thread&lt;/b&gt;&lt;br&gt;send_angles on /dev/ttyTHS1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="70" width="170" height="75" as="geometry"/></mxCell><mxCell id="s5t" value="round trip 7.7 ms p50 (#32); the Atom's sync-write to the servos 19.2 ms median, 28.0 p99 after the send" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="165" width="170" height="105" as="geometry"/></mxCell><mxCell id="s5l" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=1;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s5t"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s6" value="&lt;b&gt;6. servos move&lt;/b&gt;&lt;br&gt;Atom → servo bus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="70" width="150" height="75" as="geometry"/></mxCell><mxCell id="s6t" value="&lt;b&gt;write() → first joint change: 191.5 ms mean, 200.3 max&lt;/b&gt; (#39): mostly firmware and servo start" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1170" y="165" width="150" height="105" as="geometry"/></mxCell><mxCell id="s6l" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=1;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s6t"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s1s2" value="action" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;strokeWidth=1.5;dashed=1;dashPattern=8 4;strokeColor=#B85450;fontColor=#B85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2s3" value="action" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;strokeWidth=1.5;dashed=1;dashPattern=8 4;strokeColor=#B85450;fontColor=#B85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s3s4" value="interface" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=3;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s4s5" value="buffer" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s5s6" value="UART" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=3;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="back" value="&lt;b&gt;Back up:&lt;/b&gt; get_angles (≤ 50 ms) → pose buffer → read() → joint_state_broadcaster → &lt;b&gt;/joint_states at 30.0 Hz&lt;/b&gt;, intervals 28-39 ms (#33) → arm_controller checks tracking, MoveIt sees the result" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="285" width="830" height="45" as="geometry"/></mxCell><mxCell id="sum" value="Before the arm moves: one cycle to sample (≤ 34 ms) + a send (~20 ms) + firmware and servo start (~190 ms from write()). The Linux loop is a small part; the arm's own start dominates. Actions: move_action (MoveGroup), /arm_controller/follow_joint_trajectory." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="365" width="1320" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>