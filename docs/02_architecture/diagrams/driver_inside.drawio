<mxfile host="drawio"><diagram id="d" name="Driver inside"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1110" pageHeight="580"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cl" value="Control loop thread (30 Hz): never blocks on the port" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;arcSize=3;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="400" height="500" as="geometry"/></mxCell><mxCell id="upd" value="each cycle: &lt;b&gt;read()&lt;/b&gt; → controllers update() → &lt;b&gt;write()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="360" height="35" as="geometry"/></mxCell><mxCell id="rd" value="&lt;b&gt;read()&lt;/b&gt;&lt;br&gt;copy the newest pose out of the buffer&lt;br&gt;velocity filter · link and heartbeat watchdogs&lt;br&gt;fault → return ERROR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="360" height="80" as="geometry"/></mxCell><mxCell id="wr" value="&lt;b&gt;write()&lt;/b&gt;&lt;br&gt;check the 6 commands against the joint limits&lt;br&gt;copy them into the buffer, wake the serial thread&lt;br&gt;no I/O, no allocation, no exceptions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="360" height="80" as="geometry"/></mxCell><mxCell id="own1" value="&lt;b&gt;Owns:&lt;/b&gt; the state/command interfaces, the joint limits, the fault code (GPIO), the supervisor heartbeat watchdog (#136), the lifecycle callbacks (on_activate, on_deactivate, on_error)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="360" height="70" as="geometry"/></mxCell><mxCell id="lc" value="&lt;b&gt;on_deactivate&lt;/b&gt; (supervisor halt)&lt;br&gt;&lt;b&gt;on_error&lt;/b&gt; (any ERROR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="360" height="45" as="geometry"/></mxCell><mxCell id="bp" value="RealtimeBuffer&lt;br&gt;&lt;b&gt;newest pose&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="130" width="150" height="50" as="geometry"/></mxCell><mxCell id="bc" value="RealtimeBuffer&lt;br&gt;&lt;b&gt;newest command&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="230" width="150" height="50" as="geometry"/></mxCell><mxCell id="hq" value="halt request&lt;br&gt;(non-blocking)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#CC0000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="335" width="150" height="40" as="geometry"/></mxCell><mxCell id="stt" value="Serial thread (SerialArm): the only one on the port" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;arcSize=3;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="670" y="20" width="420" height="500" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1. pending stop or power on first&lt;/b&gt;, wait for its ack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#CC0000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="60" width="380" height="40" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2. get_angles&lt;/b&gt;, up to 50 ms for the reply → pose buffer&lt;br&gt;(skipped after a send: pose_from_poll, #170)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="115" width="380" height="45" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3. get_servo_temps&lt;/b&gt; once a second when nothing is sent&lt;br&gt;≥ 60 °C: hold targets, stop, power off (#115)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="175" width="380" height="45" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4. send_angles&lt;/b&gt; if the arm answered and there is a new target&lt;br&gt;read until the Atom's sync-write: 19.2 ms median, 28.0 ms p99&lt;br&gt;(echo_timeout 60 ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="235" width="380" height="60" as="geometry"/></mxCell><mxCell id="own2" value="&lt;b&gt;Owns:&lt;/b&gt; the port (/dev/ttyTHS1, exclusive), the frame encoder/decoder (positronic_protocol, ReplyAssembler), the order of every call: one thread, so no call can take another's reply. A turn is 10 ms at rest, ~27 ms busy after a send." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="420" width="380" height="80" as="geometry"/></mxCell><mxCell id="port" value="PosixSerialPort → UART → Atom" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="320" width="380" height="40" as="geometry"/></mxCell><mxCell id="leg" value="&lt;font color='#CC0000'&gt;&lt;b&gt;Red&lt;/b&gt;&lt;/font&gt; = halt path. Every halt ends as a stop that the serial thread sends first in its next turn; on_deactivate waits for the arm's ack." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="535" width="1070" height="30" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="bp"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="bp" target="rd"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wr" target="bc"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="bc" target="s4"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="wake" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="wr" target="s4"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="645" y="279"/><mxPoint x="645" y="283"/></Array></mxGeometry></mxCell><mxCell id="h1" value="limit refused" style="labelPosition=left;verticalLabelPosition=middle;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;strokeWidth=2.5;strokeColor=#CC0000;fontColor=#CC0000;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="wr" target="hq"><mxGeometry x="-0.4" y="15" relative="1" as="geometry"><Array as="points"><mxPoint x="364" y="347"/></Array></mxGeometry></mxCell><mxCell id="h2" value="stop" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;strokeWidth=2.5;strokeColor=#CC0000;fontColor=#CC0000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="lc" target="hq"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="h3" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;strokeWidth=2.5;strokeColor=#CC0000;fontColor=#CC0000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hq" target="s1"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="355"/><mxPoint x="650" y="80"/></Array></mxGeometry></mxCell><mxCell id="h4" value="heartbeat lost,&lt;br&gt;link silent,&lt;br&gt;fault → ERROR" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;strokeWidth=2.5;strokeColor=#CC0000;fontColor=#CC0000;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rd" target="lc"><mxGeometry x="0.2" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="179"/><mxPoint x="30" y="352"/></Array></mxGeometry></mxCell><mxCell id="p" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=3;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="port"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>