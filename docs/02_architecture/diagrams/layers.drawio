<mxfile host="drawio"><diagram id="d" name="Layers"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mission" value="&lt;b&gt;Mission&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="960" height="120" as="geometry"/></mxCell><mxCell id="mw" value="&lt;b&gt;ROS 2 middleware&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="960" height="80" as="geometry"/></mxCell><mxCell id="hal" value="&lt;b&gt;Hardware abstraction&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="960" height="150" as="geometry"/></mxCell><mxCell id="rt" value="&lt;b&gt;Real-time layer&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="960" height="110" as="geometry"/></mxCell><mxCell id="sa" value="&lt;b&gt;Sensors and actuators&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#E6E6E6;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="960" height="90" as="geometry"/></mxCell><mxCell id="mn" value="&lt;b&gt;mission_node&lt;/b&gt;&lt;br&gt;GoToPose goals [laptop]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="45" width="190" height="50" as="geometry"/></mxCell><mxCell id="mg" value="&lt;b&gt;move_group&lt;/b&gt; (