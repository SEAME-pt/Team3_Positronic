0" width="210" height="40" as="geometry"/></mxCell><mxCell id="st" value="&lt;b&gt;serial thread&lt;/b&gt; (SerialArm): poll, send, stop first [Jetson]&lt;br&gt;positronic_protocol frames, /dev/ttyTHS1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="450" width="420" height="50" as="geometry"/></mxCell><mxCell id="atom" value="&lt;b&gt;Atom&lt;/b&gt; firmware&lt;br&gt;(ESP32, arm base)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="450" width="150" height="50" as="geometry"/></mxCell><mxCell id="note" value="Low-latency, not hard real-time: Linux on the Jetson holds 33.3 ms, p99 34.0 ms (#39)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="240" y="505" width="650" height="20" as="geometry"/></mxCell><mxCell id="srv" value="6 joint servos (STS-class)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="585" width="200" height="45" as="geometry"/></mxCell><mxCell id="grp" value="gripper servo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="585" width="200" height="45" as="geometry"/></mxCell><mxCell id="usb" value="USB wrist camera" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="585" width="210" height="45" as="geometry"/></mxCell><mxCell id="safe" value="&lt;b&gt;safety_supervisor&lt;/b&gt;&lt;br&gt;[Jetson]&lt;br&gt;&lt;br&gt;heartbeats, halt.&lt;br&gt;Cuts across layers:&lt;br&gt;watches the mission,&lt;br&gt;commands the&lt;br&gt;hardware layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CC0000;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="20" width="170" height="400" as="geometry"/></mxCell><mxCell id="leg" value="Each layer talks only to the one below it. Only the real-time layer touches the serial port; degrees exist only below the plugin, radians above (REP 103)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1150" height="30" as="geometry"/></mxCell><mxCell id="a1" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mn" target="mg"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=3;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cm" target="plug"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="buffers" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;startArrow=block;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="plug" target="st"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="UART" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=none;strokeWidth=3;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st" target="atom"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a5" value="bus" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyl