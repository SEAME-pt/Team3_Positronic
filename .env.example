# Copy this file to .env and edit it.
# one KEY=value per line, no quotes, no spaces and comments on their own lines.
#
# GPU for Gazebo and RViz in the dev container:
#   dri     Intel, AMD and two GPUs notebooks.
#   nvidia  NVIDIA, needs the NVIDIA Container Toolkit installed.
#   sw      Software rendering (slow, but works in VM's).
#   empty   No GPU override, Mesa decides. (Mesa is the graphics driver stack for linux).
GPU=

# Jetson's IP. "make doctor" checks that it is reachable. Leave it out to skip that check.
# ARM_IP=

# Other overrides, only if you need them (an empty value would replace the default).
# NANO=nano
# NANO_DIR=positronic/yourname
