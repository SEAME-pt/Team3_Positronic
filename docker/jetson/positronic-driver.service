# Positronic driver container on the Jetson, started at boot (#19).
# Source of truth: this file in the repo. `make nano-service` installs it to
# /etc/systemd/system/ on the Jetson. Never edit the installed copy.
#
# The image is positronic-runtime:nano: the `runtime` target of docker/Dockerfile (ros2_control,
# pymycobot, no MoveIt/Gazebo/RViz). Build it on the Jetson with `make nano-image` BEFORE
# installing this unit, or the service fails to start (it stops retrying after 5 attempts).
#
# For now the container runs a placeholder that only keeps it alive, so ROS 2 is reachable
# and the serial port is mapped. The driver's launch command replaces it when the driver
# exists (#21-#23); the driver must then come up inactive (lifecycle) after boot.

[Unit]
Description=Positronic driver container (ROS 2 Jazzy)
Documentation=https://github.com/feazeved/Positronic/blob/dev/docs/build.md
# Docker must be running, and DDS picks its network interfaces at start-up,
# so wait until the Wi-Fi is up or laptops won't discover the Jetson.
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# Give up after 5 failed starts in 2 minutes; `systemctl status` then shows why.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Remove a container left behind by a power cut ("-" = don't fail if there is none).
ExecStartPre=-/bin/sh -c '/usr/bin/docker rm -f positronic-driver 2>/dev/null || true'
# Wi-Fi power saving off (#147). With it on, wlan0 has 0.2-0.4 s gaps that the safety
# supervisor (#45) reads as a lost link. Ubuntu's /etc/NetworkManager/conf.d/
# default-wifi-powersave-on.conf turns it on for every profile, and `iw` alone is undone at the
# next reconnect. So: powersave 2 (off) on the profile active on wlan0, which NetworkManager
# keeps across reconnects and reboots, then `iw` for the link that is up now.
# "-": no Wi-Fi (cable only, wlan0 down) must not keep the driver from starting. The step then
# shows as failed in `systemctl status`, with the reason in `journalctl -u positronic-driver`.
# A network joined later without restarting this unit keeps Ubuntu's default (on).
ExecStartPre=-/bin/sh -c '\
  c=$$(/usr/bin/nmcli -g GENERAL.CONNECTION device show wlan0 2>/dev/null); \
  if [ -z "$$c" ] || [ "$$c" = "--" ]; then \
    echo "wlan0 has no active connection, Wi-Fi power saving not changed"; exit 1; fi; \
  /usr/bin/nmcli connection modify "$$c" 802-11-wireless.powersave 2 \
  && /sbin/iw dev wlan0 set power_save off \
  && echo "Wi-Fi power saving off on wlan0 (profile $$c)"'
# Runs in the foreground (no -d) so systemd supervises the real process.
# --rm and no --restart: systemd is the only supervisor.
# --init: forwards SIGTERM to the process, so `docker stop` ends it at once.
# Its own name, not positronic-arm, so `make nano-shell` keeps working.
# ROS_DOMAIN_ID must be the same on every machine that talks to the arm, or they can't see
# each other. 17 is also set in the Makefile (ROS_DOMAIN_ID ?= 17), compose.yaml and
# .devcontainer/devcontainer.json: change all four together. It's repeated here because
# systemd can't read the Makefile. Same for the image name (NANO_IMAGE in Makefile).
ExecStart=/usr/bin/docker run --rm --init --name positronic-driver \
  --network host --ipc host -e ROS_DOMAIN_ID=17 \
  --device /dev/ttyTHS1 \
  positronic-runtime:nano \
  bash -c 'source /opt/ros/jazzy/setup.bash && exec sleep infinity'
ExecStop=/usr/bin/docker stop -t 10 positronic-driver
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
